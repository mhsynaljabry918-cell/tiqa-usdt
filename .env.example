NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/tiqa_usdt
FRONTEND_ORIGIN=http://localhost:5500
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_DAYS=14
OTP_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_DELIVERY_MODE=console
ALLOW_INSECURE_OTP_LOGS=true
OTP_PEPPER=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Email OTP (SMTP). Without these values, OTP delivery is disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TiqaUSDT <no-reply@example.com>

# SMS OTP (Twilio). Optional; keep empty until a provider account is ready.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# First administrator is created only through the CLI script.
